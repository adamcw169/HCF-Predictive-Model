/* HCF Anchor Predictor - flat, neutral palette with a single blue accent.
 *
 * Adapted from the HCF Draw Predictor's stylesheet so the two apps read as one
 * toolset. Same palette, same flat surfaces; the additions at the end are for
 * widgets this app uses and that one does not (metric readouts, the anchor-count
 * badge, editable threshold cells).
 *
 * Palette:
 *   background  #F4F5F7   surface #FFFFFF   border #DFE3E8
 *   text        #1F2933   muted   #6B7684
 *   accent      #2D6CDF   accent-dark #1F4FA8
 *   warn        #B7791F on #FFF8E6
 *   error       #C53030 on #FDECEC
 *   ok          #2F855A on #EAF6EF
 */

QWidget {
    background-color: #F4F5F7;
    color: #1F2933;
    font-family: "Segoe UI", "Segoe UI Variable", Arial, sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #F4F5F7;
}

/* Labels and check boxes must not paint the window colour over the white
 * cards they sit inside. Banner labels re-declare their own background. */
QLabel, QCheckBox, QRadioButton {
    background-color: transparent;
}

/* ---------------------------------------------------------- tabs ------- */

QTabWidget::pane {
    border: 1px solid #DFE3E8;
    border-radius: 6px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #6B7684;
    padding: 9px 20px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #2D6CDF;
    border-bottom: 2px solid #2D6CDF;
}

QTabBar::tab:hover:!selected {
    color: #1F2933;
}

QTabBar::tab:disabled {
    color: #B4BAC2;
}

/* ------------------------------------------------------- group box ----- */

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DFE3E8;
    border-radius: 6px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #1F2933;
}

/* --------------------------------------------------------- buttons ----- */

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #C9CFD6;
    border-radius: 5px;
    padding: 7px 16px;
    color: #1F2933;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #F0F3F7;
    border-color: #A9B2BC;
}

QPushButton:pressed {
    background-color: #E4E9F0;
}

QPushButton:disabled {
    background-color: #F4F5F7;
    color: #B4BAC2;
    border-color: #E4E7EB;
}

QPushButton[accent="true"] {
    background-color: #2D6CDF;
    border: 1px solid #2D6CDF;
    color: #FFFFFF;
}

QPushButton[accent="true"]:hover {
    background-color: #2760C7;
    border-color: #2760C7;
}

QPushButton[accent="true"]:pressed {
    background-color: #1F4FA8;
}

QPushButton[accent="true"]:disabled {
    background-color: #B9CCEC;
    border-color: #B9CCEC;
    color: #FFFFFF;
}

/* ---------------------------------------------------------- inputs ----- */

QDoubleSpinBox, QSpinBox, QLineEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C9CFD6;
    border-radius: 5px;
    padding: 6px 8px;
    selection-background-color: #2D6CDF;
    selection-color: #FFFFFF;
    min-height: 18px;
}

QDoubleSpinBox:focus, QSpinBox:focus, QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2D6CDF;
}

QDoubleSpinBox:disabled, QSpinBox:disabled, QLineEdit:disabled, QComboBox:disabled {
    background-color: #F4F5F7;
    color: #B4BAC2;
}

/* An input the operator still has to fill in before the app can act. Used on
 * the Predict tab's analytic fields, which have no default and must not look
 * like they are already answered. */
QDoubleSpinBox[required="pending"], QLineEdit[required="pending"] {
    border: 1px solid #E0A020;
    background-color: #FFFCF4;
}

QDoubleSpinBox::up-button, QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    background-color: #F7F8FA;
    border-left: 1px solid #DFE3E8;
    border-top-right-radius: 4px;
}

QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    background-color: #F7F8FA;
    border-left: 1px solid #DFE3E8;
    border-bottom-right-radius: 4px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: #E8F0FD;
}

/* The arrow sub-controls are left to the Fusion style to draw. CSS
 * border-triangles render as solid blocks here, so the native arrows are both
 * cleaner and more reliable. */

QComboBox::drop-down {
    border: none;
    width: 22px;
    background-color: transparent;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DFE3E8;
    selection-background-color: #E8F0FD;
    selection-color: #1F2933;
    outline: none;
    padding: 4px;
}

/* ----------------------------------------------------------- table ----- */

QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #FAFBFC;
    border: 1px solid #DFE3E8;
    border-radius: 5px;
    gridline-color: #EDEFF2;
    selection-background-color: #E8F0FD;
    selection-color: #1F2933;
    outline: none;
}

QHeaderView::section {
    background-color: #F7F8FA;
    color: #6B7684;
    padding: 7px 8px;
    border: none;
    border-right: 1px solid #EDEFF2;
    border-bottom: 1px solid #DFE3E8;
    font-weight: 600;
}

QTableView::item {
    padding: 4px 6px;
}

/* An editable cell has to be visibly different from a read-only one, or the
 * threshold table looks like a report the operator cannot change. */
QTableView::item:selected {
    background-color: #E8F0FD;
}

QTableCornerButton::section {
    background-color: #F7F8FA;
    border: none;
    border-bottom: 1px solid #DFE3E8;
}

/* ---------------------------------------------------------- text ------- */

QTextBrowser, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #DFE3E8;
    border-radius: 5px;
    padding: 6px;
    selection-background-color: #E8F0FD;
    selection-color: #1F2933;
}

/* ------------------------------------------------- plot navigation ----- */

/* matplotlib's Qt navigation toolbar ships with its own icons and no styling,
 * so it lands on the page looking like a different application. Styled as a
 * small light card to match the buttons above it.
 *
 * The background here is NOT cosmetic and must not be set to `transparent`.
 * matplotlib decides whether to draw its icons black or white by reading
 * `toolbar.palette().color(toolbar.backgroundRole()).value() < 128`. A
 * transparent background resolves to #000000 with zero alpha, whose value() is
 * 0, so matplotlib concludes the app is in dark mode and paints white icons -
 * invisible on this palette. An opaque light colour keeps that check honest.
 * `PlotPanel` also pins the palette role directly, so the icons stay dark even
 * if this rule is edited later. */
QToolBar {
    background-color: #F5F6F8;
    border: 1px solid #E4E7EB;
    border-radius: 5px;
    spacing: 2px;
    padding: 2px 4px;
}

QToolButton {
    background-color: #F5F6F8;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    margin: 0;
}

QToolButton:hover {
    background-color: #E4ECFB;
    border-color: #9FBDEE;
}

QToolButton:checked {
    background-color: #D8E5FA;
    border-color: #2D6CDF;
}

QToolButton:pressed {
    background-color: #C9D9F5;
    border-color: #1F4FA8;
}

QToolButton:disabled {
    background-color: #F5F6F8;
    border-color: transparent;
}

/* Collapsible-section headers. A text button with a disclosure arrow, not one
 * of the small icon buttons the rules above are shaped for, so it overrides
 * them rather than inheriting a 4px icon padding. */
QToolButton[role="collapse"] {
    background-color: transparent;
    border: none;
    padding: 4px 2px;
    color: #2D6CDF;
    font-weight: 600;
    text-align: left;
}

QToolButton[role="collapse"]:hover {
    background-color: transparent;
    border: none;
    color: #1F4FA8;
    text-decoration: underline;
}

QToolButton[role="collapse"]:pressed, QToolButton[role="collapse"]:checked {
    background-color: transparent;
    border: none;
    color: #1F4FA8;
}

QToolBar::separator {
    background-color: #DFE3E8;
    width: 1px;
    margin: 4px 3px;
}

/* The coordinate readout matplotlib appends to its toolbar. */
QToolBar QLabel {
    color: #6B7684;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 8pt;
}

/* -------------------------------------------------------- progress ----- */

QProgressBar {
    background-color: #EDEFF2;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #2D6CDF;
    border-radius: 4px;
}

/* --------------------------------------------------------- banners ----- */

QLabel[banner="info"] {
    background-color: #EDF2FB;
    border: 1px solid #C7D8F5;
    border-left: 4px solid #2D6CDF;
    border-radius: 5px;
    padding: 11px 14px;
    color: #1F3E75;
}

QLabel[banner="warn"] {
    background-color: #FFF8E6;
    border: 1px solid #F3DFA8;
    border-left: 4px solid #E0A020;
    border-radius: 5px;
    padding: 11px 14px;
    color: #7A5410;
}

QLabel[banner="error"] {
    background-color: #FDECEC;
    border: 1px solid #F5C6C6;
    border-left: 4px solid #C53030;
    border-radius: 5px;
    padding: 11px 14px;
    color: #8C2020;
}

QLabel[banner="ok"] {
    background-color: #EAF6EF;
    border: 1px solid #BFE3CE;
    border-left: 4px solid #2F855A;
    border-radius: 5px;
    padding: 11px 14px;
    color: #22603F;
}

QLabel[role="heading"] {
    font-size: 13pt;
    font-weight: 600;
    color: #1F2933;
}

QLabel[role="subheading"] {
    color: #6B7684;
}

QLabel[role="mono"] {
    font-family: "Consolas", "Cascadia Mono", monospace;
    color: #6B7684;
}

/* The fitted function, in words. The one line an operator has to be able to
 * read without opening anything, so it is set apart from the body text rather
 * than sitting inside it: monospace so the coefficients line up, and on its own
 * tinted card so the eye lands on it first. */
QLabel[role="equation"] {
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 11pt;
    font-weight: 600;
    color: #1F3E75;
    background-color: #EDF2FB;
    border: 1px solid #C7D8F5;
    border-left: 4px solid #2D6CDF;
    border-radius: 5px;
    padding: 10px 13px;
}

/* Where the equation above came from. Deliberately quieter than the equation
 * and louder than body text: it is the second thing read, never the first, but
 * it must not look optional either - "Auto chose this" and "a held-out search
 * chose this" are different enough to act on. Sits directly under the equation
 * card and is indented to read as belonging to it. */
QLabel[role="provenance"] {
    color: #4A5568;
    background-color: #F7F9FC;
    border-left: 3px solid #C7D8F5;
    border-radius: 0px 4px 4px 0px;
    padding: 6px 11px;
    margin: 0px 0px 4px 0px;
}

/* A standing explanation of how two controls relate - not a status message and
 * not dismissible. Distinct from Banner, which is transient and colour-codes a
 * result; this says the same thing on every run because it is always true. */
QLabel[role="explainer"] {
    color: #3E4C59;
    background-color: #FBF7EE;
    border: 1px solid #E8DCC2;
    border-radius: 5px;
    padding: 9px 12px;
}

/* The dev dialog's action bar, pinned below the scroll area. The top rule is
 * what tells the eye the buttons are outside the scrolled region rather than
 * merely at the bottom of it. */
QWidget[role="actionbar"] {
    background-color: #F7F9FC;
    border-top: 1px solid #DFE3E8;
}

/* A predicted setpoint. Large enough to read from a step back at the draw
 * tower, which is where these numbers get used. */
QLabel[role="metric"] {
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 15pt;
    font-weight: 600;
    color: #1F2933;
}

QLabel[role="metric-unit"] {
    color: #6B7684;
}

/* How many anchor draws a prediction rests on. Deliberately always visible
 * next to the number it qualifies: a prediction from three anchors and one
 * from thirty must not look alike. */
QLabel[role="badge"] {
    background-color: #EDF2FB;
    border: 1px solid #C7D8F5;
    border-radius: 9px;
    padding: 2px 10px;
    color: #1F4FA8;
    font-weight: 600;
    font-size: 9pt;
}

QLabel[role="badge-thin"] {
    background-color: #FFF8E6;
    border: 1px solid #F3DFA8;
    border-radius: 9px;
    padding: 2px 10px;
    color: #7A5410;
    font-weight: 600;
    font-size: 9pt;
}

/* --------------------------------------------------------- scroll ------ */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C9CFD6;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #A9B2BC;
}

QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #C9CFD6;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #A9B2BC;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ------------------------------------------------------ status bar ----- */

QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #DFE3E8;
    color: #6B7684;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: #1F2933;
    color: #FFFFFF;
    border: none;
    padding: 6px 9px;
    border-radius: 4px;
}

QSplitter::handle {
    background-color: #DFE3E8;
}
